FROM python:3.11-slim

WORKDIR /app

COPY backend/pyproject.toml /app/
COPY backend/app /app/app
COPY crawler/artifacts/deploy/listings_deploy.csv /app/data/listings_curated.csv

RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -e .

ENV PT_APP_ENV=production
ENV PT_APP_DEBUG=false
ENV PT_DATABASE_ENABLED=false
ENV PT_LISTING_DATASET_PATH=/app/data/listings_curated.csv
ENV PT_LISTING_MAP_DEFAULT_LIMIT=900

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
